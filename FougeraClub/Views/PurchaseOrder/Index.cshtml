@model IEnumerable<FougeraClub.Services.DTOs.PurchaseOrdersDtos.PurchaseOrdersAndSupplier>
@{
    ViewData["Title"] = "قائمة أوامر الشراء";
    var suppliers = ViewBag.Suppliers as IEnumerable<FougeraClub.Services.DTOs.SupplierDtos.SupplierDto> ?? new List<FougeraClub.Services.DTOs.SupplierDtos.SupplierDto>();

    bool isFiltered = !string.IsNullOrEmpty(ViewBag.FromDate?.ToString()) ||
                      !string.IsNullOrEmpty(ViewBag.ToDate?.ToString()) ||
                      !string.IsNullOrEmpty(ViewBag.SupplierVATNumber?.ToString());
}

<div id="page-container" class="page-container flex-grow-1">
    <div class="row my-3 d-flex justify-content-between align-items-center flex-wrap">
        <div class="col-md-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                    <li class="breadcrumb-item"><a href="#">وحدة أوامر الشراء</a></li>
                    <li class="breadcrumb-item active">قائمة أوامر الشراء</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 d-flex align-items-center gap-1 flex-wrap justify-content-end">
            <div class="records-count-box bg-opacity-10 rounded border-opacity-25 h-auto">
                <span>عدد السجلات:</span>
                <span id="recordsCount">@(Model?.Count() ?? 0)</span>
                <input type="hidden" id="NewCountRecords" value="@(Model?.Count() ?? 0)">
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-start">
                    <div class="d-flex align-items-center col-md-6 flex-wrap">
                        <h4 class="ico-header-title my-1 ms-lg-1 ms-md-1">
                            <i class="fa-solid fa-cart-shopping me-2 text-ico"></i>قائمة أوامر الشراء
                        </h4>
                    </div>
                    <div class="col-md-6 d-flex align-items-center justify-content-end gap-1 flex-wrap">
                        <a asp-action="Create" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-plus me-1"></i> اضافة جديد
                        </a>
                        @*<button type="button" class="btn btn-success btn-sm" onclick="openPrintPage()">
                            <i class="fa fa-print me-1"></i> طباعة
                        </button>
                        <a class="btn btn-success Excelbtn btn-sm text-white" onclick="openExcelPage();">
                            <i class="fa-solid fa-file-excel me-2" style="font-size:17px;"></i>تصدير Excel
                        </a>*@
                    </div>
                </div>

                <div class="rounded shadow-sm p-3">
                    <form method="get" asp-action="Index" id="carFilterForm" class="filterImg rounded p-2">
                        <div class="row">
                            <div class="filter-dropdown col-md-4">
                                <label for="dateFrom" class="fw-medium mb-2">من تاريخ:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="fromDate" id="dateFrom" class="form-control form-select-sm filter-bordered" value="@ViewBag.FromDate">
                                </div>
                            </div>
                            <div class="filter-dropdown col-md-4">
                                <label for="dateTo" class="fw-medium mb-2">إلى تاريخ:</label>
                                <div class="input-icon-left">
                                    <img src="https://cdn-icons-png.flaticon.com/512/747/747310.png" alt="calendar icon" class="date-icon">
                                    <input type="date" name="toDate" id="dateTo" class="form-control form-select-sm filter-bordered" value="@ViewBag.ToDate">
                                </div>
                            </div>
                            <div class="filter-dropdown col-md-4">
                                <label for="supplierSelect" class="fw-medium mb-2">المورد:</label>
                                <select class="form-select form-select-sm filter-bordered select2" id="supplierSelect" name="VATNumber">
                                    <option value="">كل الموردين</option>
                                    @foreach (var supplier in suppliers)
                                    {
                                        <!option value="@supplier.VATNumber" @(ViewBag.SupplierVATNumber == supplier.VATNumber ? "selected" : "")>
                                        @supplier.Name
                                        </!option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end align-items-center p-2 gap-2 flex-wrap mt-2">
                            <a asp-action="Index" class="btn-cancel-search btn-sm btn @(isFiltered ? "" : "disabled")">
                                <i class="fa-solid fa-xmark me-1"></i> إلغاء
                            </a>
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="ri-filter-line me-1"></i> بحث
                            </button>
                        </div>
                    </form>

                    <div id="PartialNewListContainer" class="mt-3">
                        @*<nav class="d-flex justify-content-end align-items-center gap-2 my-2">
                            <label class="form-label mb-0" for="pageSizeSelect">عرض:</label>
                            <select id="pageSizeSelect" class="form-select form-select-sm w-auto">
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </nav>*@

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>رقم أمر الشراء</th>
                                        <th>اسم المورد</th>
                                        <th>التاريخ</th>
                                        <th style="width: 150px;">أدوات التحكم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td data-label="رقم أمر الشراء"><span class="fw-medium">@item.Id</span></td>
                                                <td data-label="اسم المورد">@item.Name</td>
                                                <td data-label="التاريخ">@item.Date.ToString("dd-MM-yyyy")</td>
                                                <td data-label="أدوات التحكم">
                                                    <span data-bs-toggle="tooltip" title="التفاصيل">
                                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-control btn-icon btn-sm rounded-circle">
                                                            <i class="fa-solid fa-eye fs-5"></i>
                                                        </a>
                                                    </span>
                                                    <span data-bs-toggle="tooltip" title="@(item.IsAsign ? "لا يمكن التعديل - تم الاعتماد" : "تعديل")">
                                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                                           class="btn-control btn-icon btn-sm rounded-circle @(item.IsAsign ? "disabled-btn" : "")"
                                                           style="@(item.IsAsign ? "pointer-events: none; opacity: 0.5;" : "")">
                                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                                        </a>
                                                    </span>

                                                    <span data-bs-toggle="tooltip" title="@(item.IsAsign ? "لا يمكن الحذف - تم الاعتماد" : "حذف")">
                                                        <button type="button"
                                                                onclick="confirmDelete(@item.Id)"
                                                                class="btn-control btn-icon btn-sm rounded-circle @(item.IsAsign ? "disabled-btn" : "")"
                                                                @(item.IsAsign ? "disabled" : "")
                                                                style="@(item.IsAsign ? "opacity: 0.5; cursor: not-allowed;" : "")">
                                                            <i class="fa-solid fa-trash fs-5"></i>
                                                        </button>
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center p-4 text-muted">لا يوجد بيانات لعرضها</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav class="d-flex justify-content-center align-items-center flex-wrap mt-3">
                                <ul class="pagination pagination-rounded">
                                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage - 1, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, VATNumber = ViewBag.SupplierVATNumber })">السابق</a>
                                    </li>
                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, VATNumber = ViewBag.SupplierVATNumber })">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage + 1, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, VATNumber = ViewBag.SupplierVATNumber })">التالي</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Print Function logic
        function openPrintPage() {
            const dateFrom = $('#dateFrom').val();
            const dateTo = $('#dateTo').val();
            const selectedSupplier = $('#supplierSelect').val();
            const countRecords = $('#NewCountRecords').val();

            if (countRecords > 3999) {
                Swal.fire('خطأ', 'لا يمكن طباعة أكثر من 3999 سجل', 'error');
            } else {
                const url = `/Admin/PurchaseOrder/Print?selectedSupplier=${selectedSupplier}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
                window.open(url, 'printWindow', 'width=1000,height=800,noopener,noreferrer');
            }
        }

        // Excel Export logic
        function openExcelPage() {
            const dateFrom = $('#dateFrom').val();
            const dateTo = $('#dateTo').val();
            const selectedSupplier = $('#supplierSelect').val();
            const url = `/Admin/PurchaseOrder/createExcelReport_Download?selectedSupplier=${selectedSupplier}&dateFrom=${dateFrom}&dateTo=${dateTo}`;
            window.open(url, '_self');
        }

        // Delete Confirmation
        function confirmDelete(id) {
            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: "لن تتمكن من التراجع عن الحذف!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'نعم، احذفه!',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Delete")/' + id;
                }
            })
        }

        $(document).ready(function () {
            // Toast Notifications
            var toastType = '@TempData["ToastType"]';
            var toastMessage = '@TempData["ToastMessage"]';
            if (toastType && toastMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: toastType,
                    title: toastMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
        });
    </script>
}