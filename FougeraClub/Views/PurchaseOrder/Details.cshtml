@model FougeraClub.Services.DTOs.InvoiceDtos.InvoiceWithItemsWithSupplierNameDto

@{
    ViewData["Title"] = "طلب شراء محلى";
}

<div id="page-container" class="page-container flex-grow-1">

    <script>
        function printDiv(divId) {
            window.print();
        }
    </script>
    <style>
        label {
            color: #fff;
            color: #fff !important;
            font-weight: 600;
        }

        .overflow-table {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

            .overflow-table::-webkit-scrollbar {
                height: 4px;
            }

            .overflow-table::-webkit-scrollbar-thumb {
                background-color: green;
                border-radius: 2px;
            }

            .overflow-table::-webkit-scrollbar-track {
                background-color: transparent;
            }

        .container {
            width: 100% !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        th, td {
            color: #000 !important;
            box-shadow: none;
            border: 1px #000 solid !important;
        }

        .form-control:disabled {
            border: 0;
            font-size: 15px;
            color: #000;
        }

        @@media print {
            html, body {
                width: 100%;
                overflow: visible !important;
            }

            .container {
                max-width: 100% !important;
            }

            img {
                max-width: 100% !important;
            }

            * {
                border: 0 !important;
                box-shadow: none !important;
            }

            .overflow-table {
                width: 100%;
                overflow-x: hidden;
            }

            .print-none,
            .custom-navbar {
                display: none !important;
            }

            body {
                background: #fff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-size: 12px;
                margin: 0 !important;
                padding: 0 !important;
            }

            #printArea {
                width: 800px !important;
                margin: 0 auto !important;
                padding: 0 !important;
            }

            .row {
                margin-left: 0 !important;
                margin-right: 0 !important;
            }

            .flex-fill {
                flex: 1 1 auto !important;
                min-width: 0 !important;
            }

            table {
                outline: none !important;
                width: 100% !important;
                max-width: 100% !important;
                table-layout: fixed !important;
                box-shadow: none !important;
                border-collapse: collapse !important;
            }

            th, td {
                background-color: #fff !important;
                border: 1px solid #000 !important;
                padding: 1px !important;
                color: #000 !important;
            }

            input {
                border: none;
                box-shadow: none !important;
                background: transparent !important;
                -webkit-appearance: none;
            }
        }
    </style>

    <div class="row my-3 d-flex justify-content-between align-items-center print-none ">
        <div class="col-md-6 d-flex align-items-center flex-wrap justify-content-strat">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 py-2 flex-nowrap">
                    <li class="breadcrumb-item"><a href="#">وحدة أوامر الشراء </a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">قائمة أوامر الشراء</a></li>
                    <li class="breadcrumb-item active">طلب شراء محلى</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 d-flex align-items-center justify-content-end gap-1 flex-wrap">
            <button onclick="printDiv('printArea')" class="print-btn btn btn-success btn-sm">
                <i class="fa fa-print me-1"></i>طباعة
            </button>
            <a class="btn-cancel-search btn-sm btn" asp-action="Index">
                رجوع <i class="fa-solid fa-arrow-left me-1"></i>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="container" id="printArea">
            <input type="hidden" id="Id" value="@Model.PurchaseOrderId">

            <div class="d-flex justify-content-between align-items-center flex-wrap border-black border-bottom p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">الإمارات العربية المتحدة</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">حكومة الفجيرة</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight: 700;">نادي الفجيرة العلمي</h5>
                    </div>
                </div>
                <div class="flex-fill text-center">
                    <center>
                        <img src="/ar/assets/images/logo-ar.png" alt="نادى الفجيره العلمى" style="width:75px;">
                    </center>
                </div>
                <div class="d-flex justify-content-end align-items-center flex-fill">
                    <div style="text-align:center">
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">UNITED ARAB EMIRATES</h5>
                        <h5 style="color:#6d6058; font-size: 16px;font-weight: 700;">GOVT. OF FUJAIRAH</h5>
                        <h5 style="color:#000000; font-size: 16px;font-weight: 700;">FUJAIRAH SCIENCE CLUB</h5>
                    </div>
                </div>
            </div>

            <div class="mb-0 w-100">
                <div class="w-50 mx-auto text-center fs-4 py-1 fw-bold">
                    طلب شراء محلى
                </div>
                <div class="w-30 mx-auto text-center fs-4 py-1 fw-bold mb-2">
                    <label for="PurchaseOrderCode2" class="form-label fw-semibold text-center fs-5" style="color:#000000 !important">رقم أمر الشراء</label>
                    <center>
                        <input id="PurchaseOrderCode2" value="@Model.PurchaseOrderId" disabled readonly class="form-control" type="text" style="background-color:#eeeeee !important; border:0; color:#af1717 !important;padding: 0 10px; text-align:center; width:120px;">
                    </center>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap mb-1 ">
                <div class="d-flex justify-content-between align-items-center flex-fill">
                    <div style="text-align:right" class="fs-5 text-black fw-semibold">التاريخ</div>
                </div>
                <div class="flex-fill text-center">
                    <center>
                        @* Assuming Date is available or use current date *@
                        <input class="form-control" type="text" readonly value="@DateTime.Now.ToString("yyyy-MM-dd")" style="border-bottom:1px dashed #ccc !important; border:0; text-align:center;">
                    </center>
                </div>
                <div class="d-flex justify-content-end align-items-center flex-fill">
                    <div style="text-align:left" class="fs-5 text-black fw-semibold">Date</div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <div class="d-flex justify-content-between align-items-center flex-fill">
                    <div style="text-align:right" class="fs-5 text-black fw-semibold">الى</div>
                </div>
                <div class="flex-fill text-center">
                    <center>
                        <input value="@Model.SupplierName" class="form-control" readonly style="border-bottom:1px dashed #ccc !important; border:0; text-align:center">
                    </center>
                </div>
                <div class="d-flex justify-content-end align-items-center flex-fill">
                    <div style="text-align:left" class="fs-5 text-black fw-semibold">to</div>
                </div>
            </div>

            <div class="overflow-table">
                <table style="width:100%; text-align:center; direction:ltr; color: #000 !important;" cellspacing="0" cellpadding="5" class="mb-3 table">
                    <thead>
                        <tr>
                            <th style="width: 5%;background-color:#fff !important; color: #000 !important;">رقم<br> No</th>
                            <th style="background-color:#fff !important; color: #000 !important; width:46%;">البيان <br> Particulars</th>
                            <th style="background-color:#fff !important; color: #000 !important;">الكميه<br> Qty</th>
                            <th style="background-color:#fff !important; color: #000 !important;">السعر<br>Price</th>
                            <th style="background-color:#fff !important; width: 10%; color: #000 !important;">الرقم الإجمالى <br> Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = 1;
                        }
                        @foreach (var item in Model.items)
                        {
                            <tr>
                                <td class="text-center">@count</td>
                                <td style="text-align:left">@item.Description</td>
                                <td>@item.Amount</td>
                                <td>@item.PricePerUnit.ToString("F2")</td>
                                <td>@((item.Amount * item.PricePerUnit).ToString("F2"))</td>
                            </tr>
                            count++;
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                            <td></td>
                            <td colspan="2" style="text-align: center;">الإجمالي Total</td>
                            <td>@Model.SubTotal.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td colspan="2" style="text-align: center;"> % VAT @Model.VATRate </td>
                            <td> @Model.VATAmount.ToString("F2") </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center;">
                                Amount: @Model.AmountInWord
                            </td>
                            <td colspan="2" style="text-align: center;">الإجمالي Total</td>
                            <td class="fw-bold"> AED @Model.TotalAmount.ToString("F2") </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex justify-content-between gap-3 mt-3" style="direction: rtl;">
                <div class="p-3 flex-fill" style="min-width: 48%; border: 1px solid #000 !important;">
                    <div class="d-flex justify-content-between fw-semibold">
                        <span>المستلم</span>
                        <span>Received By</span>
                    </div>
                    <div class="mt-3 mb-2" style="border-bottom: 1px dotted #ccc !important; height: 22px;"></div>
                    <div class="d-flex justify-content-between mt-3 fw-semibold">
                        <span>التوقيع</span>
                        <span>Signature</span>
                    </div>
                    <div class="mt-2 mb-3" style="border-bottom: 1px dotted #ccc !important; height: 22px;"></div>
                    <div class="d-flex justify-content-between mt-3 fw-semibold">
                        <span>التاريخ</span>
                        <span>Date :</span>
                    </div>
                    <div class="mt-2" style="border-bottom: 1px dotted #ccc !important; height: 22px;"></div>
                </div>

                <div class="p-3 flex-fill" style="min-width: 48%; border: 1px solid #000 !important; ">
                    <div class="d-flex justify-content-between fw-semibold">
                        <span>خول من قبل</span>
                        <span>Authorized By</span>
                    </div>
                    <div class="mt-3 mb-2" style="border-bottom: 1px dotted #ccc !important; height: 22px; text-align:center;">
                        Saif Mohamed Al Moaili
                    </div>
                    <div class="d-flex justify-content-between mt-3 fw-semibold">
                        <span>الوظيفة</span>
                        <span>Designation</span>
                    </div>
                    <div class="mt-2 mb-3" style="border-bottom: 1px dotted #ccc !important; height: 22px; text-align:center;">
                        Director
                    </div>
                    <div class="d-flex justify-content-between mt-3 fw-semibold">
                        <span>التوقيع</span>
                        <span>Signature</span>
                    </div>
                    <div class="mt-2 d-flex align-items-center justify-content-center" style="border-bottom: 1px dotted #ccc !important; height: 22px;">
                        @if (Model.IsAsign)
                        {
                            <span class="text-success fw-bold">ELECTRONICALLY SIGNED</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4" style="direction: rtl; gap: 30px;">
                <div class="flex-fill text-start" style="font-size: 13px; line-height: 1.6;">
                    <strong>هام للموردين:</strong>
                    <ol class="mt-2" style="padding-right: 20px;">
                        <li>عدم التزويد بأي بضائع أو مواد إلا باستلام تفويض تحريرياً موقعاً من قبلنا.</li>
                        <li>تعاد النسخة الثانية إلينا مع المستلم موضحاً عليها الأسعار.</li>
                        <li>يرفق أصل الطلب مع أصل الفواتير موقعاً ومختوماً تمهيداً للسداد بعد توريد المواد المطلوبة.</li>
                    </ol>
                </div>
                <div class="flex-fill text-end" style="font-size: 13px; line-height: 1.6; direction: ltr;">
                    <strong>Important for suppliers:</strong>
                    <ol class="mt-2" style="padding-left: 20px;">
                        <li>Not to supply any goods or materials without receiving a written authorization signed by us.</li>
                        <li>The second copies shall be returned to us with the recipient indicating the prices.</li>
                        <li>The original application shall be attached with the original signed and stamped invoices in preparation for payment after supplying the required materials.</li>
                    </ol>
                </div>
            </div>

        </div>
    </div>
</div>